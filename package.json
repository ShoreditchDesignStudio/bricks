{
  "name": "@shoreditchdesign/bricks",
  "version": "0.2.0",
  "private": false,
  "description": "Shoreditch Design's UI library: shadcn/ui under the hood, our tokens on top. A shadcn registry, a standalone CSS tokens file, and docs for humans and Claude.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShoreditchDesignStudio/bricks.git"
  },
  "homepage": "https://github.com/ShoreditchDesignStudio/bricks#readme",
  "keywords": [
    "shadcn",
    "shadcn-registry",
    "tailwindcss",
    "design-tokens",
    "radix-ui",
    "ui"
  ],
  "style": "bricks.css",
  "exports": {
    "./bricks.css": "./bricks.css",
    "./bricks.js": "./bricks.js",
    "./DESIGN.md": "./DESIGN.md",
    "./r/*": "./public/r/*"
  },
  "files": [
    "bricks.css",
    "bricks.js",
    "public/r",
    "DESIGN.md",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && shadcn build && node scripts/build-cdn.mjs",
    "build:local": "node scripts/build-local.mjs",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run check:tokens && npm run typecheck && npm run build && git diff --exit-code -- registry.json public/r bricks.js"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/react": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.33",
    "radix-ui": "^1.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3"
  }
}
