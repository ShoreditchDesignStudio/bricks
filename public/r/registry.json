      "css": {
        "@utility text-display-panel": {
          "font-family": "var(--font-display)",
          "font-size": "18px",
          "line-height": "24px",
          "font-weight": "500",
          "letter-spacing": "-0.005em"
        },
        "@utility text-display-section": {
          "font-family": "var(--font-display)",
          "font-size": "16px",
          "line-height": "22px",
          "font-weight": "500",
          "letter-spacing": "0"
        },
        "@utility text-display-number": {
          "font-family": "var(--font-display)",
          "font-size": "40px",
          "line-height": "40px",
          "font-weight": "400",
          "letter-spacing": "-0.02em",
          "font-variant-numeric": "lining-nums tabular-nums"
        },
        "@layer base": {
          "*": {
            "border-color": "var(--border)",
            "outline-color": "color-mix(in oklab, var(--ring) 50%, transparent)"
          },
          "html": {
            "font-variation-settings": "\"opsz\" 32",
            "scrollbar-color": "var(--input) transparent"
          },
          "body": {
            "background-color": "var(--background)",
            "color": "var(--foreground)",
            "font-family": "var(--font-inter, \"Inter\"), \"Inter\", ui-sans-serif, system-ui, sans-serif",
            "font-size": "13px",
            "line-height": "20px",
            "font-weight": "450",
            "letter-spacing": "0.005em",
            "-webkit-font-smoothing": "antialiased",
            "-moz-osx-font-smoothing": "grayscale"
          }
        },
        "[data-listing]": {
          "--accent": "var(--listing-row)"
        },
        "[data-slot=\"dropdown-menu-content\"], [data-slot=\"dropdown-menu-sub-content\"], [data-slot=\"select-content\"]": {
          "--accent": "var(--popover-row)"
        },
        "[data-slot=\"dialog-content\"], [data-slot=\"sheet-content\"], [data-slot=\"popover-content\"]": {
          "--field": "var(--popover-field)"
        },
        "[data-variant=\"inset\"] > [data-slot=\"sidebar-container\"] > [data-slot=\"sidebar-inner\"]": {
          "background-color": "transparent"
        },
        "[data-sonner-toaster] [data-sonner-toast][data-styled=\"true\"]": {
          "box-shadow": "var(--elevation-toast)"
        },
        "[data-sonner-toaster] [data-sonner-toast][data-styled=\"true\"]:focus-visible": {
          "box-shadow": "var(--elevation-toast), 0 0 0 2px var(--ring)"
        },
        "[data-sonner-toaster] [data-sonner-toast]:not([data-visible=\"false\"])": {
          "pointer-events": "auto"
        },
        ".scrollbar-visible": {
          "scrollbar-color": "auto"
        },
        ".scrollbar-visible::-webkit-scrollbar": {
          "width": "12px",
          "background": "transparent"
        },
        ".scrollbar-visible::-webkit-scrollbar-thumb": {
          "border": "3px solid transparent",
          "border-radius": "9999px",
          "background": "var(--input) padding-box"
        },
        ".scrollbar-visible::-webkit-scrollbar-thumb:hover": {
          "background-color": "var(--edge-strong)"
        },
        "@supports not selector(::-webkit-scrollbar)": {
          ".scrollbar-visible": {
            "scrollbar-color": "var(--input) transparent"
          }
        }
      }
    },
